<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="aerostack_drone">
    <!-- Include the standard PX4 x500 model -->
    <include merge="true">
      <uri>x500</uri>
    </include>

    <!-- 2D Lidar (Top mounted) -->
    <include merge="true">
      <uri>model://lidar_2d_v2</uri>
      <pose>0 0 0.1 0 0 0</pose>
    </include>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>link</child>
    </joint>

    <link name="sensor_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Forward RGB Camera -->
      <sensor name="camera" type="camera">
        <pose>0.25 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <camera name="forward_camera">
          <horizontal_fov>1.396263</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>100</far></clip>
        </camera>
        <gz_frame_id>aerostack_drone/sensor_link/camera</gz_frame_id>
      </sensor>

      <!-- Downward Rangefinder (CPU lidar) -->
      <sensor name="rangefinder" type="gpu_lidar">
        <pose>0 0 -0.1 0 1.5708 0</pose>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>-0.01</min_angle>
              <max_angle>0.01</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
        <gz_frame_id>aerostack_drone/sensor_link/rangefinder</gz_frame_id>
      </sensor>
    </link>

    <joint name="sensor_joint" type="fixed">
      <parent>base_link</parent>
      <child>sensor_link</child>
    </joint>
  </model>
</sdf>
